{
  "name": "Alerta Stock Critico Insumos - Salon de Belleza",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stock-critical-alert",
        "options": {}
      },
      "id": "node-webhook-stock",
      "name": "Webhook Stock Crítico",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "alertSubject",
              "value": "🚨 ALERTA: Insumo en Stock Crítico - {{ $json.body.itemName }}"
            },
            {
              "name": "alertDetails",
              "value": "El insumo {{ $json.body.itemName }} (Código: {{ $json.body.code }}) ha alcanzado un stock de {{ $json.body.currentStock }} unidades (Mínimo requerido: {{ $json.body.minimumStock }}). Se requiere generar orden de compra inmediata."
            }
          ]
        },
        "options": {}
      },
      "id": "node-set-stock",
      "name": "Preparar Mensaje Alerta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "https://api.telegram.org/bot<TOKEN>/sendMessage",
        "options": {},
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "chat_id",
              "value": "@salon_administracion"
            },
            {
              "name": "text",
              "value": "={{ $json.alertSubject }}\n\n{{ $json.alertDetails }}"
            }
          ]
        }
      },
      "id": "node-alert-sender",
      "name": "Notificar Administración",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Webhook Stock Crítico": {
      "main": [
        [
          {
            "node": "Preparar Mensaje Alerta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar Mensaje Alerta": {
      "main": [
        [
          {
            "node": "Notificar Administración",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {}
}
