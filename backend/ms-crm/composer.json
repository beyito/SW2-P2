{
    "name": "salon/ms-crm",
    "type": "project",
    "description": "Microservicio de CRM, Fidelización y Facturación - Laravel, Clean Architecture y GraphQL",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "nuwave/lighthouse": "^6.0",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "testcontainers/testcontainers": "1.2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "classmap": ["tests/Fakes.php"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
