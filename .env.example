# ====================================================================
# Variables de Entorno - Plataforma Salón de Belleza (entorno local)
# Copie este archivo a .env SOLO si .env aún no existe.
# Los valores son de desarrollo; las claves reales nunca se versionan.
# ====================================================================

# --- PostgreSQL (ms-gestion, ms-crm y Keycloak) ---
POSTGRES_USER=salon_admin
POSTGRES_PASSWORD=salon_secret_pass
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- MongoDB (ms-asesoria) ---
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=mongo_secret_pass
MONGO_DATABASE=salon_asesoria
MONGO_PORT=27017

# --- DynamoDB Local (Sesiones e Idempotencia) ---
DYNAMODB_PORT=8000

# --- RabbitMQ (Bus de Eventos y SAGA) ---
RABBITMQ_DEFAULT_USER=rabbit_admin
RABBITMQ_DEFAULT_PASS=rabbit_secret_pass
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Keycloak (SSO) ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secret_pass

# --- n8n (Automatización omnicanal) ---
N8N_PORT=5678
N8N_ENCRYPTION_KEY=clave_local_de_desarrollo_n8n

# --- Google Gemini (Reportes generativos del Servidor MCP) ---
GEMINI_API_KEY=

# --- Stripe en modo prueba (Paso pivote de la SAGA) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
