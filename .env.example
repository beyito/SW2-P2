# ====================================================================
# Variables de Entorno - Plataforma Salón de Belleza (entorno local)
# Copie este archivo a .env SOLO si .env aún no existe.
# Los valores son de desarrollo; las claves reales nunca se versionan.
# ====================================================================

# --- PostgreSQL (ms-gestion, ms-crm y Keycloak) ---
POSTGRES_USER=salon_admin
POSTGRES_PASSWORD=salon_secret_pass
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Usuario de solo lectura de los reportes dinámicos del Servidor MCP
REPORTES_PGPASSWORD=salon_reportes_local

# --- MongoDB (ms-asesoria) ---
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=mongo_secret_pass
MONGO_DATABASE=salon_asesoria
MONGO_PORT=27017

# --- DynamoDB Local (Sesiones e Idempotencia) ---
DYNAMODB_PORT=8000

# --- RabbitMQ (Bus de Eventos y SAGA) ---
RABBITMQ_DEFAULT_USER=rabbit_admin
RABBITMQ_DEFAULT_PASS=rabbit_secret_pass
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Keycloak (SSO) ---
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secret_pass

# --- n8n (Automatización omnicanal) ---
N8N_PORT=5678
N8N_ENCRYPTION_KEY=clave_local_de_desarrollo_n8n

# --- Google Gemini (Reportes generativos del Servidor MCP) ---
GEMINI_API_KEY=

# --- Stripe en modo prueba (Paso pivote de la SAGA) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Modelo de Gemini para los reportes y la marca personal, y zona horaria del salón.
# El plan gratuito permite 20 consultas diarias por modelo
GEMINI_MODEL=gemini-2.5-flash
SALON_TIMEZONE=America/La_Paz

# Días que se conservan los resultados del diagnóstico biométrico
BIOMETRIC_RETENTION_DAYS=365

# --- WhatsApp Cloud API de Meta (opcional) ---
# Sin token, los recordatorios y las confirmaciones solo se muestran como avisos dentro de la aplicación
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Clave secreta de la app (Configuración > Básica en Meta): sin ella no se comprueba la firma de los mensajes entrantes
WHATSAPP_APP_SECRET=
WHATSAPP_ADMIN_PHONE=
# Meta exige plantillas aprobadas para escribir a quien no abrió una conversación en las últimas 24 horas
WHATSAPP_TEMPLATE_CONFIRMACION=
WHATSAPP_TEMPLATE_RECORDATORIO=
WHATSAPP_TEMPLATE_STOCK=

# --- Replicate (simulación de cortes y ropa) ---
# Opcional y de pago: cada imagen consume crédito. Sin clave, esa función responde que no está disponible.
REPLICATE_API_KEY=
REPLICATE_HAIRCUT_MODEL=flux-kontext-apps/change-haircut
REPLICATE_TRY_ON_MODEL=black-forest-labs/flux-2-max
IMAGE_GEN_DAILY_LIMIT_PER_CLIENT=5
IMAGE_GEN_DAILY_LIMIT_TOTAL=30
