# ====================================================================
# Configuración del despliegue en AWS, Azure y Google Cloud.
# Copie este archivo a deploy/configuracion.env (está en .gitignore) y complételo.
# Nunca suba configuracion.env ni la carpeta deploy/salida: contienen claves.
# ====================================================================

# Dominio propio. Solo lo usa AWS: auth., gestion. y mcp. apuntan a su balanceador.
DOMINIO=
# Prefijo único y en minúsculas para los nombres globales (sitios de Firebase, PostgreSQL de Azure, registro de Azure)
PREFIJO=salon-sw2

# --- AWS (us-east-2, Ohio: una cuenta del plan gratuito solo permite esa región) ---
AWS_REGION=us-east-2
# Usuario maestro de RDS (PostgreSQL de gestión y Keycloak)
RDS_USUARIO=salon_admin
RDS_CLAVE=

# --- Azure (canadacentral: Azure for Students no permite eastus) ---
AZURE_UBICACION=canadacentral
AZURE_GRUPO=salon-rg
AZURE_PG_USUARIO=salon_admin
AZURE_PG_CLAVE=

# --- Google Cloud (us-east4) ---
GCP_PROYECTO=
GCP_REGION=us-east4

# --- MongoDB Atlas: cadena de conexión de su clúster, con la base salon_asesoria ---
# Ejemplo (con comillas simples: sin ellas Bash corta el valor en el &):
# MONGO_URI='mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/salon_asesoria?retryWrites=true&w=majority'
MONGO_URI=

# --- CloudAMQP: datos de la instancia (en CloudAMQP el usuario y el vhost son el mismo texto) ---
RABBITMQ_HOST=
RABBITMQ_USUARIO=
RABBITMQ_CLAVE=
RABBITMQ_VHOST=

# --- Keycloak ---
KEYCLOAK_ADMIN_CLAVE=
# Secreto del cliente salon-agent (n8n lo usa para pedir tokens). Genere uno largo y aleatorio.
SALON_AGENT_SECRET=

# --- Stripe (modo prueba) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Se obtiene al registrar el webhook en el panel de Stripe (paso final de azure/desplegar.sh)
STRIPE_WEBHOOK_SECRET=

# --- IA ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Opcional: sin clave solo se desactiva la simulación de imágenes
REPLICATE_API_KEY=

# --- n8n y WhatsApp (opcional; sin token los avisos solo aparecen dentro de la aplicación) ---
N8N_ENCRYPTION_KEY=
N8N_AUTOMATION_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ADMIN_PHONE=
WHATSAPP_TEMPLATE_CONFIRMACION=
WHATSAPP_TEMPLATE_RECORDATORIO=
WHATSAPP_TEMPLATE_STOCK=
