# Proxy delante de Ollama: solo responde con la clave del salón y solo expone la API de chat.
events {}
http {
    server {
        listen ${PORT};
        client_max_body_size 2m;

        location = /healthz {
            return 200 "ok";
        }

        location = /api/chat {
            if ($http_authorization != "Bearer ${OLLAMA_API_KEY}") {
                return 401;
            }
            proxy_pass http://127.0.0.1:11434;
            # En CPU una respuesta puede tardar minutos
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        location / {
            return 404;
        }
    }
}
